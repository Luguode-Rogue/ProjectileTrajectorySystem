    <string id="PTS_H002" text="显示玩家远程武器的预测弹道。" />
    <string id="PTS_003" text="敌人弹道" />
    <string id="PTS_H003" text="当敌人瞄准玩家时，显示其预测的射击线。" />
    <string id="PTS_004" text="实时投射物轨迹" />
    <string id="PTS_H004" text="显示已射出的箭矢、弩箭等投射物的实际飞行路径。" />
    <string id="PTS_G002" text="视觉效果" />
    <string id="PTS_005" text="敌人高亮" />
