    <string id="PTS_G005" text="慢动作" />
    <string id="PTS_100" text="启用慢动作" />
    <string id="PTS_H100" text="瞄准时若周围有敌人，则减慢时间流速。" />
    <string id="PTS_101" text="敌人检测范围" />
