  <strings>
    <string id="PTS_DisplayName" text="弹道轨迹系统" />
    <string id="PTS_001" text="启用弹道系统" />
    <string id="PTS_H001" text="总开关：是否启用弹道可视化和敌人高亮。" />
    <string id="PTS_G001" text="弹道显示设置" />
